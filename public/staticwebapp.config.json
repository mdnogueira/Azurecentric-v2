{
  "$schema": "https://json.schemastore.org/staticwebapp.config.json",
  "trailingSlash": "never",
  "navigationFallback": {
    "rewrite": "/404.html",
    "exclude": [
      "/images/*",
      "/_astro/*",
      "/pagefind/*",
      "/*.{png,jpg,jpeg,webp,avif,svg,ico,xml,txt,json,css,js,woff2}"
    ]
  },
  "responseOverrides": {
    "404": {
      "rewrite": "/404.html",
      "statusCode": 404
    }
  },
  "routes": [
    {
      "route": "/podcast.html",
      "redirect": "/podcast",
      "statusCode": 301
    },
    {
      "route": "/youtube.html",
      "redirect": "/videos",
      "statusCode": 301
    },
    {
      "route": "/category-azure-news.html",
      "redirect": "/categories/news",
      "statusCode": 301
    },
    {
      "route": "/category-*.html",
      "redirect": "/posts",
      "statusCode": 301
    },
    {
      "route": "/feed.xml",
      "redirect": "/rss.xml",
      "statusCode": 301
    },
    {
      "route": "/about/",
      "redirect": "/about",
      "statusCode": 301
    },
    {
      "route": "/about.html",
      "redirect": "/about",
      "statusCode": 301
    },
    {
      "route": "/_astro/*",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "route": "/pagefind/*",
      "headers": {
        "Cache-Control": "public, max-age=86400"
      }
    },
    {
      "route": "/images/*",
      "headers": {
        "Cache-Control": "public, max-age=604800"
      }
    },
    {
      "route": "/rss.xml",
      "headers": {
        "Content-Type": "application/rss+xml; charset=utf-8",
        "Cache-Control": "public, max-age=3600"
      }
    },
    {
      "route": "/rss/*",
      "headers": {
        "Content-Type": "application/rss+xml; charset=utf-8",
        "Cache-Control": "public, max-age=3600"
      }
    },
    {
      "route": "/*.html",
      "headers": {
        "Cache-Control": "public, max-age=0, must-revalidate"
      }
    }
  ],
  "globalHeaders": {
    "Content-Security-Policy": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://i.ytimg.com https://*.ytimg.com https://*.scdn.co https://*.sndcdn.com; media-src 'self' https://anchor.fm https://*.spotifycdn.com https://*.soundcloud.com https://*.sndcdn.com https://*.podbean.com https://*.buzzsprout.com; font-src 'self'; connect-src 'self'; frame-src https://www.youtube-nocookie.com https://open.spotify.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests",
    "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "Permissions-Policy": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()",
    "Cross-Origin-Opener-Policy": "same-origin"
  },
  "mimeTypes": {
    ".avif": "image/avif",
    ".webp": "image/webp",
    ".woff2": "font/woff2",
    ".pf_meta": "application/octet-stream",
    ".pf_index": "application/octet-stream",
    ".pf_fragment": "application/octet-stream",
    ".pagefind": "application/octet-stream"
  }
}
