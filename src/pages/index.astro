---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import PostRow from '../components/PostRow.astro';
import EpisodeCard from '../components/EpisodeCard.astro';
import VideoCard from '../components/VideoCard.astro';
import ListenBlock from '../components/ListenBlock.astro';
import CategoryList from '../components/CategoryList.astro';
import hero from '../assets/hero.png';
import { site, youtubeChannels } from '../../site.config.mjs';
import { getLang, useTranslations, localePath } from '../i18n/utils';
import { postsFor, categoryCounts } from '../lib/posts';
import { episodes, videosFor } from '../lib/feeds';

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const posts = (await postsFor(lang)).slice(0, site.homePostCount);
const [featured, ...rest] = posts;
const cards = rest.slice(0, 2);
const rows = rest.slice(2);
const cats = (await categoryCounts(lang)).slice(0, 6);
const latestEpisode = episodes()[0];
const channel = youtubeChannels[0];
const videos = videosFor(channel.slug).slice(0, 3);
---
<Base title={site.name} active="home">
  <section class="hero">
    <Image src={hero} alt="" class="hero-img" widths={[480, 800, 1400]} sizes="100vw" format="avif" loading="eager" fetchpriority="high" />
    <div class="container hero-inner">
      <div class="hero-text">
        <p class="eyebrow">{t('home.eyebrow')}</p>
        <h1>{site.tagline[lang]}</h1>
        <p class="lead">{site.description[lang]}</p>
        <div class="chips hs">
          {cats.map((c) => <a href={localePath(lang, `/categories/${c.key}`)} class="chip">{c.name}</a>)}
        </div>
      </div>
      {latestEpisode && (
        <div class="hero-episode">
          <div class="section-head mobile-only">
            <h2>{t('home.latestEpisode')}</h2>
            <a href={localePath(lang, '/podcast')}>{t('home.podcast')} →</a>
          </div>
          <EpisodeCard episode={latestEpisode} />
        </div>
      )}
    </div>
  </section>

  <main class="page container">
    <div class="cols home-cols">
      <div class="main">
        {featured && (
          <section class="section o1">
            <div class="section-head">
              <h2>{t('home.latestPost')}</h2>
              <a href={localePath(lang, '/posts')}>{t('home.allPosts')} →</a>
            </div>
            <PostCard post={featured} featured />
          </section>
        )}
        {cards.length > 0 && (
          <div class="cards o3">
            {cards.map((p) => <PostCard post={p} />)}
          </div>
        )}
        {rows.length > 0 && (
          <section class="section o4">
            <div class="section-head">
              <h2>{t('home.recentPosts')}</h2>
              <a href={localePath(lang, '/posts')}>{t('home.byCategory')} →</a>
            </div>
            <div class="rows">
              {rows.slice(0, 3).map((p) => <PostRow post={p} />)}
              {rows.length > 3 && (
                <details class="more">
                  <summary class="btn">{t('home.morePosts')}</summary>
                  <div class="rows">{rows.slice(3).map((p) => <PostRow post={p} />)}</div>
                </details>
              )}
            </div>
            <a href={localePath(lang, '/posts')} class="btn older">{t('home.olderPosts')} →</a>
          </section>
        )}
      </div>

      <aside class="side">
        <section class="section o2">
          <div class="section-head">
            <h2>{channel.name}</h2>
            <a href={localePath(lang, `/videos/${channel.slug}`)}>YouTube →</a>
          </div>
          {videos.length === 0 && <p class="muted">{t('videos.empty')}</p>}
          <div class="videos hs">
            {videos.map((v) => <VideoCard video={v} channel={channel} layout="tile" />)}
          </div>
        </section>
        <div class="o5 desktop-only"><CategoryList /></div>
        <div class="o6"><ListenBlock stacked /></div>
      </aside>
    </div>
  </main>
</Base>

<style>
  .hero { position: relative; overflow: hidden; background: #1c395f; }
  .hero-img { width: 100%; height: 200px; object-fit: cover; object-position: 50% 40%; }
  .hero-inner { display: flex; flex-direction: column; gap: 22px; padding-block: 18px 22px; }
  .hero-text { display: flex; flex-direction: column; gap: 12px; }
  .hero-episode { display: flex; flex-direction: column; gap: 10px; }
  .mobile-only { display: flex; }
  .desktop-only { display: none; }
  .home-cols > .main, .home-cols > .side { display: contents; }
  .home-cols > .main > *, .home-cols > .side > * { width: 100%; min-width: 0; }
  .o1 { order: 1; } .o2 { order: 2; } .o3 { order: 3; } .o4 { order: 4; } .o5 { order: 5; } .o6 { order: 6; }
  .cards { display: flex; flex-direction: column; gap: 16px; }
  .videos { display: flex; gap: 12px; overflow-x: auto; margin-inline: calc(-1 * var(--gutter)); padding-inline: var(--gutter); padding-bottom: 4px; }
  .more { display: contents; }
  .more summary { list-style: none; margin-top: 12px; }
  .more summary::-webkit-details-marker { display: none; }
  .more[open] summary { display: none; }
  .older { display: none; align-self: flex-start; }

  @media (min-width: 900px) {
    .hero-img { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0.6; object-position: 50% 50%; }
    .hero-inner { position: relative; flex-direction: row; flex-wrap: wrap; gap: 32px; padding-block: 72px 64px; align-items: stretch; }
    .hero-text { flex: 1 1 420px; min-width: 0; justify-content: center; gap: 16px; }
    .hero-text .lead { color: #d4e9f6; }
    .hero-text .chip { background: #17325a; border-color: #3d6da0; color: #fff; }
    .hero-episode { flex: 1 1 360px; max-width: 460px; }
    .hero-episode :global(.card) { background: #17325a; border: 1px solid #3d6da0; height: 100%; }
    .mobile-only { display: none; }
    .desktop-only { display: block; }
    .home-cols > .main { display: flex; }
    .home-cols > .side { display: flex; }
    .cards { flex-direction: row; flex-wrap: wrap; }
    .cards > :global(*) { flex: 1 1 240px; min-width: 0; }
    .videos { flex-direction: column; overflow: visible; margin-inline: 0; padding-inline: 0; }
    .videos :global(.video.tile) { flex-direction: row; width: auto; gap: 12px; }
    .videos :global(.video.tile .thumb) { width: 128px; height: 72px; }
    .videos :global(.video.tile .play) { width: 32px; height: 32px; }
    .videos :global(.video.tile .title) { font-size: 14px; }
    .more { display: block; }
    .more summary { display: none; }
    .more > .rows { display: flex; }
    .older { display: inline-flex; }
  }
</style>

<script>
  // Desktop shows every row without the "show more" control.
  const mq = window.matchMedia('(min-width: 900px)');
  const sync = () => document.querySelectorAll<HTMLDetailsElement>('details.more').forEach((d) => { if (mq.matches) d.open = true; });
  sync();
  mq.addEventListener('change', sync);
</script>
