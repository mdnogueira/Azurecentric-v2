---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import PlayIcon from '../../components/PlayIcon.astro';
import { site } from '../../../site.config.mjs';
import { getLang, useTranslations, localePath, formatDate, formatDuration } from '../../i18n/utils';
import { allPosts, postsFor, postLang, postSlug, categoryName, readingTime, translationOf, type Post } from '../../lib/posts';
import { episodes } from '../../lib/feeds';

export async function getStaticPaths() {
  const posts = await allPosts();
  // One URL per translationKey; the EN file names the slug, PT-only posts use their own.
  const byKey = new Map<string, Post>();
  for (const p of posts) {
    const cur = byKey.get(p.data.translationKey);
    if (!cur || (postLang(p) === 'en' && postLang(cur) !== 'en')) byKey.set(p.data.translationKey, p);
  }
  return [...byKey.values()].map((post) => ({ params: { slug: postSlug(post) }, props: { base: post } }));
}

const { base } = Astro.props as { base: Post };
const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const translated = postLang(base) === lang ? base : await translationOf(base, lang);
const post = translated ?? base;
const notTranslated = !translated;
const other = await translationOf(post, lang === 'pt' ? 'en' : 'pt');
const { Content, headings } = await render(post);
const toc = headings.filter((h) => h.depth === 2);
const related = (await postsFor(lang)).filter((p) => p.data.category === post.data.category && p.id !== post.id).slice(0, 1);
const slug = postSlug(base);
const episode = episodes().find((e) => post.data.tags.some((tag) => e.title.toLowerCase().includes(tag.replace('-', ' '))));
const cover = post.data.cover;
---
<Base
  title={post.data.title}
  description={post.data.description}
  fallback={notTranslated}
  active="posts"
  back={localePath(lang, '/posts')}
  type="article"
  publishedTime={post.data.pubDate.toISOString()}
  image={cover ? undefined : undefined}
>
  <div class="progress" aria-hidden="true"><div data-progress></div></div>
  <main class="page container article">
    <article>
      <header class="section">
        <div class="meta muted">
          <a href={localePath(lang, `/categories/${post.data.category}`)} class="tag">{categoryName(post.data.category, lang)}</a>
          <span>{readingTime(post)} {t('post.minRead')}</span>
          <span aria-hidden="true">·</span>
          <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate, lang)}</time>
          {post.data.updatedDate && <span>· {t('post.updated')} {formatDate(post.data.updatedDate, lang)}</span>}
        </div>
        <h1>{post.data.title}</h1>
        <div class="byline">
          <span class="avatar">{site.author.split(' ').map((w) => w[0]).join('').slice(0, 2)}</span>
          <div class="who">
            <span><strong>{site.author}</strong></span>
            {other && (
              <span class="muted">{t('post.alsoIn')} <a href={localePath(lang === 'pt' ? 'en' : 'pt', `/posts/${slug}`)}>{lang === 'pt' ? 'English' : 'Português'} →</a></span>
            )}
          </div>
          <button type="button" class="icon-btn share" data-share data-title={post.data.title} aria-label={t('post.share')}><Icon name="share" size={20} /></button>
        </div>
        {notTranslated && <p class="notice">{t('post.notTranslated')}</p>}
        {cover && <Image src={cover} alt={post.data.coverAlt ?? ''} widths={[480, 800, 1200]} sizes="(min-width: 900px) 760px, 100vw" format="avif" class="cover" loading="eager" />}
        {toc.length > 1 && (
          <details class="toc card">
            <summary>{t('post.onThisPage')} <Icon name="down" size={18} stroke={2} /></summary>
            <ol>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
          </details>
        )}
      </header>

      <div class="prose" data-pagefind-body>
        <Content />
      </div>

      <footer class="section post-footer">
        <div class="tags">
          {post.data.tags.map((tag) => <a href={localePath(lang, `/tags/${tag}`)} class="chip small">#{tag}</a>)}
        </div>
        {episode && (
          <section class="card listen">
            <span class="eyebrow" style="color: var(--muted)">{t('post.listen')}</span>
            <a href={localePath(lang, '/podcast')} class="ep">
              <span class="ep-play" aria-hidden="true"><PlayIcon size={20} color="#fff" /></span>
              <span class="row-text">
                <span class="row-title">{episode.number ? `#${episode.number} — ` : ''}{episode.title}</span>
                <span class="row-meta">{episode.durationSeconds ? formatDuration(episode.durationSeconds, lang) : ''}</span>
              </span>
            </a>
          </section>
        )}
        {related.length > 0 && (
          <section class="section">
            <span class="eyebrow" style="color: var(--muted)">{t('post.continue')}</span>
            {related.map((p) => (
              <a href={localePath(lang, `/posts/${postSlug(p)}`)} class="card next">
                <span class="row-title">{p.data.title}</span>
                <Icon name="chevron" size={20} stroke={2} />
              </a>
            ))}
          </section>
        )}
      </footer>
    </article>
  </main>
</Base>

<style>
  .article { max-width: 820px; }
  .meta { display: flex; align-items: center; gap: 8px; font-size: 13px; flex-wrap: wrap; }
  h1 { font-size: clamp(28px, 5vw, 40px); }
  .byline { display: flex; align-items: center; gap: 10px; padding-bottom: 16px; border-bottom: 1px solid var(--line); font-size: 13px; }
  .avatar { width: 32px; height: 32px; border-radius: 999px; background: var(--accent); color: var(--accent-ink); display: inline-flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 700; }
  .who { display: flex; flex-direction: column; gap: 1px; }
  .share { margin-left: auto; border: 1px solid var(--line); border-radius: 999px; }
  .notice { margin: 0; padding: 10px 14px; border-radius: 10px; background: var(--card); font-size: 14px; color: var(--muted); }
  .cover { border-radius: 14px; width: 100%; height: auto; }
  .toc { border: 1px solid var(--line-strong); }
  .toc summary { list-style: none; padding: 12px 14px; font-size: 14px; font-weight: 600; display: flex; align-items: center; justify-content: space-between; cursor: pointer; min-height: 44px; }
  .toc summary::-webkit-details-marker { display: none; }
  .toc ol { margin: 0; padding: 0 14px 12px 30px; font-size: 14px; line-height: 1.9; color: var(--muted); }
  .post-footer { padding-top: 10px; gap: 18px; }
  .tags { display: flex; flex-wrap: wrap; gap: 8px; }
  .chip.small { padding: 7px 12px; font-size: 13px; background: transparent; }
  .listen { padding: 16px; display: flex; flex-direction: column; gap: 8px; }
  .ep { display: flex; align-items: center; gap: 12px; color: var(--text); }
  .ep-play { width: 44px; height: 44px; border-radius: 10px; background: var(--azure); display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; }
  .next { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 14px 16px; color: var(--text); border: 1px solid var(--line-strong); }
</style>

<script>
  const fill = document.querySelector<HTMLElement>('[data-progress]');
  const onScroll = () => {
    const h = document.documentElement;
    const max = h.scrollHeight - h.clientHeight;
    if (fill) fill.style.width = `${max > 0 ? (h.scrollTop / max) * 100 : 0}%`;
  };
  document.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  document.querySelectorAll<HTMLButtonElement>('[data-share]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const data = { title: btn.dataset.title, url: location.href };
      try {
        if (navigator.share) await navigator.share(data);
        else { await navigator.clipboard.writeText(location.href); btn.setAttribute('aria-label', 'Copied'); }
      } catch {}
    });
  });

  // Copy button on code blocks
  document.querySelectorAll<HTMLPreElement>('.prose pre').forEach((pre) => {
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.textContent = 'Copy';
    btn.className = 'copy';
    btn.style.cssText = 'position:absolute;top:8px;right:8px;height:30px;padding:0 10px;border-radius:8px;border:1px solid var(--line-strong);background:var(--card);color:var(--text);font-size:12px;font-weight:600;cursor:pointer';
    pre.style.position = 'relative';
    btn.addEventListener('click', async () => {
      try { await navigator.clipboard.writeText(pre.innerText); btn.textContent = 'Copied'; setTimeout(() => (btn.textContent = 'Copy'), 1500); } catch {}
    });
    pre.appendChild(btn);
  });
</script>
