---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import PostRow from '../../components/PostRow.astro';
import CategoryList from '../../components/CategoryList.astro';
import { getLang, useTranslations, localePath } from '../../i18n/utils';
import { postsFor, categoryCounts, allTags } from '../../lib/posts';
import { categories } from '../../../site.config.mjs';

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const posts = await postsFor(lang);
const cats = await categoryCounts(lang);
const tags = await allTags(lang);
const iconOf = (key: string) => (categories as Record<string, { icon: string }>)[key]?.icon ?? 'posts';
---
<Base title={t('posts.title')} active="posts">
  <main class="page container">
    <div class="cols">
      <div class="main">
        <section class="section">
          <h1>{t('posts.title')}</h1>
          <p class="lead">{t('posts.intro', { count: posts.length, cats: cats.length })}</p>
          <button type="button" class="search-field" data-open-search>
            <Icon name="search" size={20} />
            <span>{t('nav.search.placeholder')}</span>
          </button>
          <div class="cat-strip">
            {cats.map((c) => (
              <a href={localePath(lang, `/categories/${c.key}`)} class="chip"><Icon name={iconOf(c.key)} size={16} /> {c.name} <span class="muted">{c.count}</span></a>
            ))}
          </div>
        </section>

        <section class="section" id="latest">
          <div class="section-head">
            <h2>{t('posts.latest')}</h2>
          </div>
          <div class="rows">
            {posts.map((p) => <PostRow post={p} />)}
          </div>
        </section>
      </div>

      <aside class="side">
        <CategoryList showAll={false} />
        {tags.length > 0 && (
          <section class="section">
            <div class="section-head"><h2>{t('posts.tags')}</h2></div>
            <div class="tags">
              {tags.map((tag) => <a href={localePath(lang, `/tags/${tag}`)} class="chip" data-tag={tag}>#{tag}</a>)}
            </div>
          </section>
        )}
      </aside>
    </div>
  </main>
</Base>

<style>
  .search-field {
    display: flex; align-items: center; gap: 10px; height: 48px; padding: 0 14px; border-radius: 12px;
    background: var(--card); border: 1px solid var(--line-strong); color: var(--muted); font-size: 16px; cursor: pointer; text-align: left;
  }
  .cat-strip { display: flex; gap: 8px; overflow-x: auto; padding-bottom: 4px; margin-inline: calc(-1 * var(--gutter)); padding-inline: var(--gutter); scrollbar-width: none; }
  .cat-strip::-webkit-scrollbar { display: none; }
  .cat-strip .chip { flex: 0 0 auto; display: inline-flex; align-items: center; gap: 6px; font-size: 13px; white-space: nowrap; }
  .cat-strip .muted { font-size: 12px; }
  @media (min-width: 900px) { .cat-strip { display: none; } }
  .tags { display: flex; flex-wrap: wrap; gap: 8px; }
  .tags .chip { padding: 6px 10px; font-size: 13px; background: transparent; }
</style>
