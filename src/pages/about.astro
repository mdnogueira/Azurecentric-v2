---
// The bio text lives in src/content/about/en.md and pt.md — edit those, not this file.
// The picture is src/assets/about.png.
import { Image } from 'astro:assets';
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { site, podcast } from '../../site.config.mjs';
import { getLang, useTranslations } from '../i18n/utils';
import portrait from '../assets/about.png';

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const entry = (await getEntry('about', lang)) ?? (await getEntry('about', 'en'))!;
const { Content } = await render(entry);
---
<Base title={t('about.title')} active="about">
  <main class="page container">
    <section class="section">
      <h1>{entry.data.title}</h1>
      <p class="lead">{site.description[lang]}</p>
    </section>

    <section class="bio">
      <Image src={portrait} alt={site.author} width={600} height={1167} loading="eager" class="portrait" />
      <div class="prose text">
        <Content />
      </div>
    </section>

    <section class="section">
      <h2>{t('about.find')}</h2>
      <div class="links">
        <a href={site.social.youtube} class="btn" target="_blank" rel="noopener"><Icon name="video" size={18} />YouTube</a>
        <a href={podcast.links.spotify} class="btn" target="_blank" rel="noopener"><Icon name="headphones" size={18} />Podcast</a>
        <a href={site.social.linkedin} class="btn" target="_blank" rel="noopener"><Icon name="external" size={18} />LinkedIn</a>
        <a href={site.social.twitter} class="btn" target="_blank" rel="noopener"><Icon name="external" size={18} />X / Twitter</a>
      </div>
    </section>
  </main>
</Base>

<style>
  /* Phone: picture centred above the text. From 700px: picture on the left, text on the right. */
  .bio { display: flex; flex-direction: column; align-items: center; gap: 20px; }
  .bio :global(.portrait) { width: 200px; height: auto; flex: 0 0 auto; }
  .text { width: 100%; min-width: 0; }
  @media (min-width: 700px) {
    .bio { flex-direction: row; align-items: flex-start; gap: 32px; }
    .bio :global(.portrait) { width: 240px; }
    .text { flex: 1 1 0; width: auto; }
  }
  @media (min-width: 1000px) {
    .bio { gap: 40px; }
    .bio :global(.portrait) { width: 280px; }
  }
  .links { display: flex; flex-wrap: wrap; gap: 8px; }
</style>
