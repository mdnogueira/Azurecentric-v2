---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { site, podcast } from '../../site.config.mjs';
import { getLang, useTranslations } from '../i18n/utils';
const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
---
<Base title={t('about.title')} active="about">
  <main class="page container article">
    <section class="section">
      <h1>{site.author}</h1>
      <p class="lead">{site.description[lang]}</p>
    </section>
    <div class="prose">
      {lang === 'pt' ? (
        <>
          <p>[Escreva aqui a sua biografia — quem é, o que faz com Azure no terreno, e porque é que este site existe. Dois ou três parágrafos chegam.]</p>
          <h2>Onde me encontrar</h2>
        </>
      ) : (
        <>
          <p>[Write your bio here — who you are, what you do with Azure in the field, and why this site exists. Two or three paragraphs is enough.]</p>
          <h2>Where to find me</h2>
        </>
      )}
      <div class="links">
        <a href={site.social.youtube} class="btn" target="_blank" rel="noopener"><Icon name="video" size={18} />YouTube</a>
        <a href={podcast.links.spotify} class="btn" target="_blank" rel="noopener"><Icon name="headphones" size={18} />Podcast</a>
        <a href={site.social.linkedin} class="btn" target="_blank" rel="noopener"><Icon name="external" size={18} />LinkedIn</a>
        <a href={site.social.twitter} class="btn" target="_blank" rel="noopener"><Icon name="external" size={18} />X / Twitter</a>
      </div>
    </div>
  </main>
</Base>

<style>
  .article { max-width: 820px; }
  .links { display: flex; flex-wrap: wrap; gap: 8px; }
</style>
