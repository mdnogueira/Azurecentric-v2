---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import type { ImageMetadata } from 'astro';
import type { Post } from '../lib/posts';

interface Props { post: Post; width: number; height: number; class?: string; sizes?: string }
const { post, width, height, class: cls, sizes } = Astro.props;
const { remarkPluginFrontmatter } = await render(post);
const first = remarkPluginFrontmatter.firstArticleImage as
  { src: string; alt: string; assetPath?: string } | undefined;
const assets = import.meta.glob<ImageMetadata>('/src/assets/**/*.{avif,gif,jpeg,jpg,png,svg,webp}', {
  eager: true,
  import: 'default',
});
const asset = first?.assetPath ? assets[first.assetPath] : undefined;
if (first?.assetPath?.startsWith('/src/assets/') && !asset) {
  throw new Error('Cannot resolve the first article image for ' + post.id + ': ' + first.assetPath);
}
---
<span class:list={['thumb', cls]} aria-hidden={first ? undefined : 'true'}>
  {first ? (
    asset ? (
      <Image src={asset} alt={first.alt} width={width} height={height} format="webp" sizes={sizes} loading="lazy" />
    ) : (
      <img src={first.src} alt={first.alt} width={width} height={height} sizes={sizes} loading="lazy" />
    )
  ) : (
    <img src="/images/logo-symbol.png" alt="" class="symbol" width="217" height="166" loading="lazy" />
  )}
</span>

