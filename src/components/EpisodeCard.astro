---
// Latest-episode card with a native <audio> player (no third-party embed).
import Icon from './Icon.astro';
import PlayIcon from './PlayIcon.astro';
import { getLang, useTranslations, localePath, formatDate, formatDuration } from '../i18n/utils';
import { podcast } from '../../site.config.mjs';
import type { Episode } from '../lib/feeds';

interface Props { episode: Episode; compact?: boolean }
const { episode, compact = false } = Astro.props;
const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const dur = episode.durationSeconds ? formatDuration(episode.durationSeconds, lang) : '';
const mmss = (s: number) => `${Math.floor(s / 60)}:${String(Math.round(s % 60)).padStart(2, '0')}`;
const watch = episode.audioUrl ? undefined : (episode as any).youtubeId ? `https://www.youtube.com/watch?v=${(episode as any).youtubeId}` : episode.link;
---
<article class="card episode" data-episode>
  <div class="head">
    <span class="art" aria-hidden="true"><Icon name="mic" size={26} stroke={1.8} /></span>
    <div class="text">
      <span class="eyebrow">{podcast.title}{episode.number ? ` · #${episode.number}` : ''}</span>
      <h3 class="title">{episode.title}</h3>
      <span class="meta muted">{dur}{dur && ' · '}{formatDate(new Date(episode.pubDate), lang)}</span>
    </div>
  </div>
  <div class="player">
    {episode.audioUrl ? (
      <>
        <button type="button" class="play" aria-label={`${t('podcast.episode')} ${episode.number ?? ''}`} data-play>
          <span class="when-paused"><PlayIcon size={20} /></span>
          <span class="when-playing"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M7 5h4v14H7zM13 5h4v14h-4z"/></svg></span>
        </button>
        <div class="bar" data-bar><div data-fill></div></div>
        <span class="time"><span data-current>0:00</span> / <span>{episode.durationSeconds ? mmss(episode.durationSeconds) : '--:--'}</span></span>
        <audio preload="none" src={episode.audioUrl} data-audio></audio>
      </>
    ) : (
      <a class="play" href={watch} target="_blank" rel="noopener" aria-label={t('videos.watch')}><PlayIcon size={20} /></a>
    )}
    {!episode.audioUrl && <span class="muted small">{t('videos.watch')} →</span>}
  </div>
  {!compact && (
    <p class="muted small">{t('podcast.synced')} · <a href={localePath(lang, '/podcast')}>{t('podcast.all')} →</a></p>
  )}
</article>

<style>
  .episode { padding: 16px; display: flex; flex-direction: column; gap: 14px; }
  .head { display: flex; gap: 12px; align-items: center; }
  .art {
    width: 56px; height: 56px; border-radius: 12px; background: var(--azure); color: #fff;
    display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0;
  }
  .text { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
  .title { font-size: 17px; line-height: 1.3; }
  .meta { font-size: 13px; }
  .player { display: flex; align-items: center; gap: 12px; }
  .play {
    width: 44px; height: 44px; border-radius: 999px; border: 0; background: var(--accent); color: var(--accent-ink);
    display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; cursor: pointer;
  }
  .when-playing { display: none; }
  .episode.playing .when-playing { display: inline-flex; }
  .episode.playing .when-paused { display: none; }
  .bar { flex: 1; height: 6px; border-radius: 999px; background: var(--bg); overflow: hidden; cursor: pointer; }
  .bar div { width: 0; height: 100%; background: var(--accent); }
  .time { font-family: var(--font-mono); font-size: 12px; color: var(--muted); white-space: nowrap; }
  .small { font-size: 12px; margin: 0; }
  @media (min-width: 900px) {
    .episode { padding: 24px; gap: 18px; }
    .art { width: 72px; height: 72px; border-radius: 16px; }
    .title { font-size: 20px; }
    .play { width: 48px; height: 48px; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-episode]').forEach((card) => {
    const audio = card.querySelector<HTMLAudioElement>('[data-audio]');
    const play = card.querySelector<HTMLButtonElement>('[data-play]');
    const fill = card.querySelector<HTMLElement>('[data-fill]');
    const bar = card.querySelector<HTMLElement>('[data-bar]');
    const cur = card.querySelector<HTMLElement>('[data-current]');
    if (!audio || !play) return;
    const fmt = (s: number) => `${Math.floor(s / 60)}:${String(Math.floor(s % 60)).padStart(2, '0')}`;
    play.addEventListener('click', () => {
      if (audio.paused) {
        document.querySelectorAll<HTMLAudioElement>('audio').forEach((a) => a !== audio && a.pause());
        audio.play();
      } else audio.pause();
    });
    audio.addEventListener('play', () => card.classList.add('playing'));
    audio.addEventListener('pause', () => card.classList.remove('playing'));
    audio.addEventListener('timeupdate', () => {
      if (fill && audio.duration) fill.style.width = `${(audio.currentTime / audio.duration) * 100}%`;
      if (cur) cur.textContent = fmt(audio.currentTime);
    });
    bar?.addEventListener('click', (e) => {
      const r = bar.getBoundingClientRect();
      if (audio.duration) audio.currentTime = ((e.clientX - r.left) / r.width) * audio.duration;
    });
  });
</script>
