---
import PostThumb from './PostThumb.astro';
import { getLang, useTranslations, localePath, formatDate } from '../i18n/utils';
import { postSlug, categoryName, readingTime, type Post } from '../lib/posts';

interface Props { post: Post; showCategory?: boolean }
const { post, showCategory = true } = Astro.props;
const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
---
<a href={localePath(lang, `/posts/${postSlug(post)}`)} class="row" data-tags={post.data.tags.join(',')}>
  <PostThumb post={post} width={152} height={152} />
  <span class="row-text">
    <span class="row-title">{post.data.title}</span>
    <span class="row-meta">
      {showCategory && <>{categoryName(post.data.category, lang)} · </>}
      {readingTime(post)} {t('post.minRead')} · {formatDate(post.data.pubDate, lang)}
    </span>
    {post.data.tags.length > 0 && (
      <span class="row-tags">{post.data.tags.map((tag) => <span class="row-tag">#{tag}</span>)}</span>
    )}
  </span>
</a>

<style>
  .row-tags { display: flex; flex-wrap: wrap; gap: 4px 8px; margin-top: 2px; }
  .row-tag { font-size: 12px; color: var(--link); }
</style>
